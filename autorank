local WH = { url="", enabled=false, cats={Huge=true,Titanic=true,Gargantuan=true}, queue={}, imgCache={} }
local CAT_COLORS = { Huge=0x3BA3FF, Titanic=0xB45CFF, Gargantuan=0xFFB020 }

local function httpPost(url, body)
    local req = (type(request)=="function" and request)
             or (type(http_request)=="function" and http_request)
             or (syn and type(syn.request)=="function" and syn.request)
    if not req then return false, "no HTTP" end
    local ok, res = pcall(req, { Url=url, Method="POST",
        Headers={["Content-Type"]="application/json"}, Body=body })
    if not ok then return false, tostring(res) end
    local status = tonumber(res and (res.StatusCode or res.Status)) or 0
    return status >= 200 and status < 300, "HTTP "..status
end

local function petInfo(id)
    return type(G.Pets) == "table" and G.Pets[id] or nil
end

local function petCat(id)
    local pd = petInfo(id)
    local name = tostring((pd and pd.name) or id or "")
    for _, cat in ipairs({ "Gargantuan", "Titanic", "Huge" }) do
        if name:sub(1, #cat+1) == cat.." " then return cat end
    end
end

local function petImg(id)
    if WH.imgCache[id] ~= nil then return WH.imgCache[id] or nil end
    local pd = petInfo(id)
    local asset = pd and tostring(pd.thumbnail or ""):match("(%d+)")
    if not asset then WH.imgCache[id] = false; return nil end
    local req = (type(request)=="function" and request)
             or (type(http_request)=="function" and http_request)
             or (syn and type(syn.request)=="function" and syn.request)
    if not req then WH.imgCache[id] = false; return nil end
    local url = ("https://thumbnails.roblox.com/v1/assets?assetIds=%s&size=420x420&format=Png"):format(asset)
    local ok, res = pcall(req, { Url=url, Method="GET" })
    local payload = ok and res and tostring(res.Body or "") or ""
    local img = payload:match('"imageUrl"%s*:%s*"([^"]+)"')
    if img then img = img:gsub("\\/", "/") end
    WH.imgCache[id] = img or false
    return img
end

local function sendPet(petId, egg)
    if WH.url == "" then return end
    local cat = petCat(petId)
    if not cat then return end
    local pd = petInfo(petId)
    local fields = {}
    if pd then
        local p = tonumber(pd.power) or tonumber(pd.cachedPower and pd.cachedPower[1])
        if p then fields[#fields+1] = { name="Power", value=math.floor(p), inline=true } end
    end
    if egg then fields[#fields+1] = { name="Egg", value=tostring(egg), inline=true } end
    local embed = {
        author={name="Pet Simulator 99"}, title=tostring(petId),
        description="**"..cat.."**", color=CAT_COLORS[cat] or 5814783,
        fields=fields, footer={text="Nexus Hub · "..os.date("%H:%M:%S")},
    }
    local img = petImg(petId)
    if img then embed.thumbnail = { url=img } end
    local body = HttpService:JSONEncode({ username="Nexus Hub", embeds={embed} })
    local ok, msg = httpPost(WH.url, body)
    if not ok then warnlog("webhook fail: "..tostring(msg)) end
end

