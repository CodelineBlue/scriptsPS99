local function farmTick()
    if not CONFIG.AutoFarm or state.worldSwitching or state.worldMismatch or inInstance() then return end
    ensureInBestZone()
    local zoneId = bestZoneId()
    if not zoneId then return end
    local pets = petEuids()
    state.farmPets = #pets
    if #pets == 0 then return end
    local things = workspace:FindFirstChild("__THINGS")
    local folder = things and things:FindFirstChild("Breakables")
    if not folder then return end
    local p1, p2, p3 = {}, {}, {}
    for _, m in ipairs(folder:GetChildren()) do
        if m:IsA("Model") and m:GetAttribute("ParentID") == zoneId then
            local uid = m:GetAttribute("BreakableUID")
            if uid then
                local pr = classifyBreakable(m)
                if pr == 1 then p1[#p1+1] = uid
                elseif pr == 2 then p2[#p2+1] = uid
                else p3[#p3+1] = uid end
            end
        end
    end
    local targets, tier
    if #p1 > 0 then targets, tier = p1, 1
    elseif #p2 > 0 and wantsDiamonds() then targets, tier = p2, 2
    else
        targets = {}
        for _, u in ipairs(p2) do targets[#targets+1] = u end
        for _, u in ipairs(p3) do targets[#targets+1] = u end
        tier = 3
    end
    state.farmTargets = #targets
    if #targets == 0 then return end
    if tier < farmLastTier then breakAssign = {} end
    farmLastTier = tier
    local live, used, petSet = {}, {}, {}
    for _, u in ipairs(targets) do live[u] = true end
    for _, e in ipairs(pets) do petSet[e] = true end
    for e, u in pairs(breakAssign) do
        if live[u] and petSet[e] then used[u] = true
        else breakAssign[e] = nil end
    end
    local free = {}
    for _, u in ipairs(targets) do if not used[u] then free[#free+1] = u end end
    local rr = 0
    local map = {}
    for _, e in ipairs(pets) do
        if breakAssign[e] == nil then
            if #free > 0 then breakAssign[e] = table.remove(free, 1)
            else rr = rr + 1; breakAssign[e] = targets[(rr - 1) % #targets + 1] end
        end
        map[e] = breakAssign[e]
    end
    unreliable("Breakables_PlayerDealDamage", targets[1])
    fire("Breakables_JoinPetBulk", map)
    state.counters.farm = state.counters.farm + 1
end

local function installBreakableListener()
    task.spawn(function()
        local t0 = os.clock()
        local folder
        while state.alive and os.clock() - t0 < 60 do
            local things = workspace:FindFirstChild("__THINGS")
            folder = things and things:FindFirstChild("Breakables")
            if folder then break end
            task.wait(1)
        end
        if not folder then return end
        folder.ChildAdded:Connect(function(m)
            if not (state.alive and CONFIG.AutoFarm) then return end
            if not m:IsA("Model") then return end
            task.defer(function()
                if not state.alive then return end
                local zoneId = bestZoneId()
                if not zoneId or m:GetAttribute("ParentID") ~= zoneId then return end
                if classifyBreakable(m) ~= 1 then return end
                local uid = m:GetAttribute("BreakableUID")
                if not uid then return end
                local pets = petEuids()
                if #pets == 0 then return end
                local map = {}
                for _, e in ipairs(pets) do map[e] = uid; breakAssign[e] = uid end
                farmLastTier = 1
                unreliable("Breakables_PlayerDealDamage", uid)
                fire("Breakables_JoinPetBulk", map)
            end)
        end)
    end)
end

