local ID_GAME, ID_EXEC = 2, 8
local canSetId = type(setthreadidentity) == "function"
local function gcall(fn, ...)
    if type(fn) ~= "function" then return false, "not a function" end
    if canSetId then pcall(setthreadidentity, ID_GAME) end
    local r = table.pack(pcall(fn, ...))
    if canSetId then pcall(setthreadidentity, ID_EXEC) end
    return table.unpack(r, 1, r.n)
end
local function gval(fn, ...)
    local ok, a, b = gcall(fn, ...)
    if ok then return a, b end
end
local function isfn(mod, name) return type(mod) == "table" and type(mod[name]) == "function" end

local onceDone, warnAt, logAt = {}, {}, {}
local function log(fmt, ...)
    local ok, s = pcall(string.format, tostring(fmt), ...)
    print("[Nexus] " .. (ok and s or tostring(fmt)))
end
local function logOnce(key, fmt, ...)
    key = tostring(key); if onceDone[key] then return end; onceDone[key] = true
    log(fmt, ...)
end
local function warnlog(key, fmt, ...)
    key = tostring(key); local now = os.clock()
    if warnAt[key] and now - warnAt[key] < 30 then return end
    warnAt[key] = now
    local ok, s = pcall(string.format, tostring(fmt), ...)
    warn("[Nexus] " .. (ok and s or tostring(fmt)))
end
local function logEvery(key, secs, fmt, ...)
    key = tostring(key); local now = os.clock()
    if logAt[key] and now - logAt[key] < secs then return end
    logAt[key] = now; log(fmt, ...)
end

