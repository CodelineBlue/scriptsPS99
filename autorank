local function readQuests()
    local out = {}
    local gs = localPlayer.PlayerGui:FindFirstChild("GoalsSide")
    local holder = gs and gs:FindFirstChild("QuestsHolder", true)
    if not holder then return out end
    for _, q in pairs(holder:GetChildren()) do
        local t = q:FindFirstChild("Title", true) or q:FindFirstChild("Desc", true)
        if t and t.Text ~= "" then
            local l = string.lower(t.Text)
            if not string.find(l, "rankup ready") then
                local text = ""
                for _, d in ipairs(q:GetDescendants()) do
                    if d:IsA("TextLabel") and d.Text ~= "" then
                        text = text .. " " .. string.lower(d.Text)
                    end
                end
                local cur, total = 0, 1
                local a, b = string.match(text, "(%d+)%s*/%s*(%d+)")
                if a and b then cur, total = tonumber(a), tonumber(b)
                else
                    local n = string.match(l, "(%d+)")
                    total = n and tonumber(n) or 1
                end
                table.insert(out, { txt = l, remaining = math.max(1, total - cur), raw = t.Text })
            end
        end
    end
    return out
end

