local breakState = { on = false, instantStored = false, instantOrig = nil,
                     potatoOrig = nil, animOrig = nil, animEnv = nil }

local function clearStuckPrompt()
    for _, root in ipairs({ game:GetService("CoreGui"), localPlayer:FindFirstChild("PlayerGui") }) do
        if root then
            for _, d in ipairs(root:GetDescendants()) do
                if d.Name == "TapToOpen" then pcall(function() d:Destroy() end) end
            end
        end
    end
end

local function setInstantBreak(on)
    if type(getsenv) == "function" then
        pcall(function()
            if on and not breakState.animOrig then
                local ps = localPlayer:FindFirstChild("PlayerScripts")
                local sc = ps and ps:FindFirstChild("Scripts")
                local ge = sc and sc:FindFirstChild("Game")
                local frontend = ge and ge:FindFirstChild("Egg Opening Frontend")
                if frontend then
                    local env = getsenv(frontend)
                    if type(env) == "table" and type(env.PlayEggAnimation) == "function" then
                        breakState.animEnv, breakState.animOrig = env, env.PlayEggAnimation
                        env.PlayEggAnimation = function() end
                    end
                end
            elseif not on and breakState.animOrig and breakState.animEnv then
                breakState.animEnv.PlayEggAnimation = breakState.animOrig
                breakState.animOrig, breakState.animEnv = nil, nil
            end
        end)
    end
    if isfn(G.SettingsCmds, "Get") then
        if on and not breakState.potatoOrig then
            breakState.potatoOrig = G.SettingsCmds.Get
            G.SettingsCmds.Get = function(label, ...)
                if label == "EggPotatoMode" then return "On" end
                return breakState.potatoOrig(label, ...)
            end
        elseif not on and breakState.potatoOrig then
            G.SettingsCmds.Get = breakState.potatoOrig
            breakState.potatoOrig = nil
        end
    end
    pcall(function()
        if on then
            if not breakState.instantStored then
                breakState.instantOrig = workspace:GetAttribute("GlobalInstantHatch")
                breakState.instantStored = true
            end
            workspace:SetAttribute("GlobalInstantHatch", true)
        elseif breakState.instantStored then
            workspace:SetAttribute("GlobalInstantHatch", breakState.instantOrig)
            breakState.instantStored = false
        end
    end)
    breakState.on = on
    if on then clearStuckPrompt() end
end

