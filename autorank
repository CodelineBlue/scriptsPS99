-- Farm
local breakAssign = {}
local function classifyBreakable(m)
    local id = string.lower(tostring(m:GetAttribute("BreakableID") or ""))
    local class = m:GetAttribute("BreakableClass")
    if class and class ~= "Normal" then return 1 end
    for _, w in ipairs({ "comet","pinata","jar","lucky","chest" }) do
        if string.find(id, w, 1, true) then return 1 end
    end
    if string.find(id, "diamond", 1, true) then return 2 end
    return 3
end

local function petEuids()
    if not (G.PlayerPet and type(G.PlayerPet.GetAll) == "function") then return {} end
    local ok, all = pcall(G.PlayerPet.GetAll)
    if not ok or type(all) ~= "table" then return {} end
    local out = {}
    for _, p in pairs(all) do
        if type(p) == "table" and p.euid then out[#out+1] = p.euid end
    end
    return out
end

local function farmTick()
    if not CONFIG.AutoFarm or inInstance() then return end
    local hrp = getHRP()
    if not hrp then return end
    local zoneId = bestZoneId()
    if not zoneId then return end
    local pets = petEuids()
    state.farmPets = #pets
    if #pets == 0 then return end
    local things = workspace:FindFirstChild("__THINGS")
    local folder = things and things:FindFirstChild("Breakables")
    if not folder then return end
    local p1, p2, p3 = {}, {}, {}
    for _, m in ipairs(folder:GetChildren()) do
        if m:IsA("Model") and m:GetAttribute("ParentID") == zoneId then
            local uid = m:GetAttribute("BreakableUID")
            if uid then
                local pr = classifyBreakable(m)
                if pr == 1 then p1[#p1+1] = uid
                elseif pr == 2 then p2[#p2+1] = uid
                else p3[#p3+1] = uid end
            end
        end
    end
    local targets
    if #p1 > 0 then targets = p1
    else
        targets = {}
        for _, u in ipairs(p2) do targets[#targets+1] = u end
        for _, u in ipairs(p3) do targets[#targets+1] = u end
    end
    state.farmTargets = #targets
    if #targets == 0 then return end
    local map = {}
    for i, e in ipairs(pets) do
        map[e] = targets[((i-1) % #targets) + 1]
        breakAssign[e] = map[e]
    end
    unreliable("Breakables_PlayerDealDamage", targets[1])
    fire("Breakables_JoinPetBulk", map)
    state.counters.farm = state.counters.farm + 1
end

