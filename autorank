                machineAction("RainbowMachine_Activate", "RainbowMachine", u.uid, u.amt)
                task.wait(0.2)
            end
            getgenv().IsDoingSpecificQuest = false
        end
    end
    if rainT < q.remaining then
        if baseT > 0 then
            local used, rem = {}, (q.remaining - rainT) * 10
            table.sort(base, function(a, b) return a.crafts > b.crafts end)
            for _, p in ipairs(base) do
                if rem > 0 then
                    local u = math.min(p.crafts, rem); table.insert(used, { uid = p.uid, amt = u }); rem = rem - u
                end
            end
            if #used > 0 then
                getgenv().IsDoingSpecificQuest = true
                gotoAndUseMachine(31, "GoldMachine")
                for _, u in ipairs(used) do
                    machineAction("GoldMachine_Activate", "GoldMachine", u.uid, u.amt)
                    task.wait(0.2)
                end
                getgenv().IsDoingSpecificQuest = false
            end
        end
        if rainT * 10 + baseT < q.remaining * 10 and eggName then
            if currentZoneByPosition() ~= bestUnlockedZone() then
                getgenv().IsMachineActionActive = true
                teleportToBestArea()
                task.wait(0.5)
                getgenv().IsMachineActionActive = false
            end
            task.spawn(function()
                pcall(function() network:FindFirstChild("Eggs_RequestPurchase"):InvokeServer(eggName, hatchQty()) end)
            end)
            task.wait(0.1)
        end
    end
end

