local function breakableSpawn(z)
    local i = z and z:FindFirstChild("INTERACT")
    local s = i and i:FindFirstChild("BREAKABLE_SPAWNS")
    return s and s:FindFirstChild("Main") or nil
end

local function pivotPosition(inst)
    if not inst then return Vector3.new(0, 0, 0) end
    if inst:IsA("Model") or inst:IsA("BasePart") then return inst:GetPivot().Position end
    local i = inst:FindFirstChild("INTERACT")
    local s = i and i:FindFirstChild("BREAKABLE_SPAWNS")
    if s and s:FindFirstChild("Main") then return s.Main:GetPivot().Position end
    local pe = inst:FindFirstChild("PERSISTENT")
    if pe then
        local p = pe:FindFirstChildWhichIsA("BasePart", true)
        if p then return p.Position end
    end
    local p = inst:FindFirstChildWhichIsA("BasePart", true)
    return p and p.Position or Vector3.new(0, 0, 0)
end

local function currentZoneByPosition()
    local hrp = localPlayer.Character and localPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return 0 end
    local rp = RaycastParams.new()
    rp.FilterDescendantsInstances = { localPlayer.Character, workspace:FindFirstChild("__THINGS") }
    rp.FilterType = Enum.RaycastFilterType.Exclude
    local hit = workspace:Raycast(hrp.Position, Vector3.new(0, -100, 0), rp)
    if hit and hit.Instance then
        local inst = hit.Instance
        while inst and inst ~= workspace do
            if inst.Parent and string.match(string.lower(inst.Parent.Name), "map") then
                local n = zoneNumberFromName(inst.Name, game.PlaceId)
                if n then return n end
            end
            inst = inst.Parent
        end
    end
    local closest, bestNum = math.huge, 0
    for _, z in ipairs(mapZones()) do
        local pos = pivotPosition(z)
        if pos ~= Vector3.new(0, 0, 0) then
            local m = (hrp.Position - pos).Magnitude
            if m < closest then closest = m; bestNum = zoneNumberFromName(z.Name, game.PlaceId) or 0 end
        end
    end
    return bestNum
end

local function currentZoneName()
    if G_Map then
        local ok, z = pcall(G_Map.GetCurrentZone)
        if ok and type(z) == "string" then return z end
    end
    local n = currentZoneByPosition()
    return n and val9[n] or nil
end

local function teleportToBreakable(zone)
    local hrp = (localPlayer.Character or localPlayer.CharacterAdded:Wait()):WaitForChild("HumanoidRootPart", 5)
    if not hrp or not zone then return false end
    local pe = zone:FindFirstChild("PERSISTENT")
    if not pe then return false end
    local tp = pe:FindFirstChild("Teleport") or pe:FindFirstChildWhichIsA("BasePart", true)
    if not tp then return false end
    local pv = tp:IsA("Model") and tp:GetPivot() or tp.CFrame
    hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
    hrp.CFrame = pv * CFrame.new(0, 15, 0)
    local main, s = nil, tick()
    repeat
        task.wait(0.1)
        local i = zone:FindFirstChild("INTERACT")
        local sp = i and i:FindFirstChild("BREAKABLE_SPAWNS")
        if sp then main = sp:FindFirstChild("Main") end
    until main or tick() - s > 3.5
    if not main then return false end
    pcall(function() network.Pets_UnequipAll:FireServer() end)
    task.wait(0.1)
    pcall(function() network.Pets_Restore:FireServer() end)
    hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
    hrp.CFrame = main:IsA("Model") and main:GetPivot() * CFrame.new(0, 5, 0)
                                       or main.CFrame * CFrame.new(0, 5, 0)
    return true
end

local function teleportToBestArea()
    local n, z = bestUnlockedZone()
    if z and teleportToBreakable(z) then return true end
    local name = zoneNameForTeleport(n)
    if name then
        pcall(function() network.Teleports_RequestTeleport:InvokeServer(name) end)
        task.wait(1.5)
        local nz = findZoneInstance(n)
        if nz then return teleportToBreakable(nz) end
        return true
    end
    return false
end

local function teleportToZone(n)
    local z = findZoneInstance(n)
    if z and teleportToBreakable(z) then return true end
    local name = zoneNameForTeleport(n)
    if name then
        pcall(function() network.Teleports_RequestTeleport:InvokeServer(name) end)
        task.wait(1.5)
        local nz = findZoneInstance(n)
        if nz then return teleportToBreakable(nz) end
        return true
    end
    return false
end

local function teleportToEgg(eggName)
    local n = getgenv().EggNameToNumber[eggName]
    if not n then return end
    local tn = tostring(n) .. " - Egg Capsule"
    local things = workspace:FindFirstChild("__THINGS")
    if not things then return end
    local egg
    if game.PlaceId == 17503543197 then
        local e = things:FindFirstChild("Eggs")
        if e then egg = e:FindFirstChild(tn, true) end
    end
    if not egg then
        local e = things:FindFirstChild("ZoneEggs")
        if e then egg = e:FindFirstChild(tn, true) end
    end
    if not egg then
        local e = things:FindFirstChild("Eggs")
        if e then egg = e:FindFirstChild(tn, true) end
    end
    local hrp = localPlayer.Character and localPlayer.Character:FindFirstChild("HumanoidRootPart")
    if egg and hrp then
        hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
        hrp.CFrame = egg:GetPivot() * CFrame.new(0, 4, 6)
    end
end

