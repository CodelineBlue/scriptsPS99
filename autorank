local function inventory(cat)
    local save = getSave()
    local inv = save and save.Inventory
    return type(inv) == "table" and type(inv[cat]) == "table" and inv[cat] or {}
end
local function stacks(cat, pred)
    local out = {}
    for uid, item in pairs(inventory(cat)) do
        if type(item) == "table" then
            local amt = tonumber(item._am) or 1
            if amt >= 1 and (pred == nil or pred(item, amt)) then
                out[#out+1] = { uid=uid, item=item, amount=amt }
            end
        end
    end
    table.sort(out, function(a,b) return a.amount > b.amount end)
    return out
end
local function pickByPriority(list, priority)
    for _, id in ipairs(priority or {}) do
        for _, s in ipairs(list) do if s.item.id == id then return s end end
    end
end

