local function slider(label, key, min, max, step, setter)
    local f = Instance.new("Frame", scroll)
    f.Size, f.BackgroundColor3, f.BorderSizePixel = UDim2.new(1, -10, 0, 28), C.panel, 0
    f.LayoutOrder = nextOrder(); corner(f, 5)
    local l = Instance.new("TextLabel", f)
    l.Size, l.Position = UDim2.new(0.55, 0, 1, 0), UDim2.new(0, 10, 0, 0)
    l.BackgroundTransparency, l.Text = 1, label .. ": " .. tostring(CONFIG[key])
    l.TextColor3, l.Font, l.TextSize = C.text, FONT_M, 11
    l.TextXAlignment = Enum.TextXAlignment.Left
    local box = Instance.new("TextBox", f)
    box.Size, box.Position = UDim2.new(0.30, 0, 0.7, 0), UDim2.new(0.65, 0, 0.15, 0)
    box.BackgroundColor3, box.BorderSizePixel = C.bg, 0
    box.Text, box.TextColor3, box.Font, box.TextSize = tostring(CONFIG[key]), C.accent, FONT, 11
    box.ClearTextOnFocus, box.TextScaled = false, true
    corner(box, 4); stroke(box, C.line, 1)
    box.FocusLost:Connect(function()
        local n = tonumber(box.Text)
        if n then
            n = math.clamp(n, min, max)
            if step then n = math.floor(n / step + 0.5) * step end
            CONFIG[key] = n
            if setter then pcall(setter, n) end
        end
        box.Text = tostring(CONFIG[key])
        l.Text = label .. ": " .. tostring(CONFIG[key])
    end)
end
local function textField(label, getter, setter, placeholder)
    local f = Instance.new("Frame", scroll)
    f.Size, f.BackgroundColor3, f.BorderSizePixel = UDim2.new(1, -10, 0, 28), C.panel, 0
    f.LayoutOrder = nextOrder(); corner(f, 5)
    local l = Instance.new("TextLabel", f)
    l.Size, l.Position = UDim2.new(0.30, 0, 1, 0), UDim2.new(0, 10, 0, 0)
    l.BackgroundTransparency, l.Text = 1, label
    l.TextColor3, l.Font, l.TextSize = C.text, FONT_M, 11
    l.TextXAlignment = Enum.TextXAlignment.Left
    local box = Instance.new("TextBox", f)
    box.Size, box.Position = UDim2.new(0.68, -10, 0.7, 0), UDim2.new(0.31, 0, 0.15, 0)
    box.BackgroundColor3, box.BorderSizePixel = C.bg, 0
    box.Text, box.TextColor3, box.Font, box.TextSize = tostring(getter() or ""), C.accent, FONT, 10
    box.PlaceholderText, box.PlaceholderColor3 = placeholder or "", C.sub
    box.ClearTextOnFocus = false
    corner(box, 4); stroke(box, C.line, 1)
    box.FocusLost:Connect(function()
        setter(box.Text)
        box.Text = tostring(getter() or "")
    end)
end
local function button(label, onClick, color)
    local b = Instance.new("TextButton", scroll)
    b.Size = UDim2.new(1, -10, 0, 28)
    b.BackgroundColor3 = color or C.accent
    b.BorderSizePixel, b.AutoButtonColor = 0, false
    b.Text = label
    b.TextColor3, b.Font, b.TextSize = C.text, FONT_M, 11
    b.LayoutOrder, b.TextXAlignment = nextOrder(), Enum.TextXAlignment.Center
    corner(b, 5)
    b.MouseButton1Click:Connect(function() pcall(onClick) end)
    return b
end

