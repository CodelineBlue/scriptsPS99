local function loadModule(key, path, optional)
    if G[key] ~= nil then return G[key] end
    local inst = RS
    for _, name in ipairs(path) do
        if not inst then return nil end
        local child = inst:FindFirstChild(name)
        if not child then
            local ok, r = pcall(function() return inst:WaitForChild(name, optional and 1 or 8) end)
            child = ok and r or nil
        end
        inst = child
    end
    if not inst then
        if not optional then warnlog("mod-"..key, "module %s missing", key) end
        return nil
    end
    local ok, mod = gcall(require, inst)
    if not ok then warnlog("mod-"..key, "require %s failed: %s", key, tostring(mod)); return nil end
    G[key] = mod
    return mod
end

local function loadAll()
    for k, p in pairs(MODULE_PATHS) do loadModule(k, p, false) end
    for k, p in pairs(OPTIONAL_PATHS) do loadModule(k, p, true) end
    if type(G.Directory) == "table" then
        local function dirSub(name)
            local ok, t = gcall(function() return G.Directory[name] end)
            if ok and type(t) == "table" then return t end
            return loadModule(name, {"Library","Directory",name}, true)
        end
        G.Ranks = dirSub("Ranks"); G.Zones = dirSub("Zones")
        G.Eggs = dirSub("Eggs"); G.Potions = dirSub("Potions")
        G.Enchants = dirSub("Enchants")
    end
end

local netFolder = RS:FindFirstChild("Network")
local function fire(name, ...)
    if isfn(G.Network, "Fire") then return gcall(G.Network.Fire, name, ...) end
    local rem = netFolder and netFolder:FindFirstChild(name)
    if rem and rem:IsA("RemoteEvent") then
        local ok, a = pcall(function() return rem:FireServer(...) end)
        return ok, a
    end
    return false, "no remote " .. name
end
local function invoke(name, ...)
    if isfn(G.Network, "Invoke") then return gcall(G.Network.Invoke, name, ...) end
    local rem = netFolder and netFolder:FindFirstChild(name)
    if rem and rem:IsA("RemoteFunction") then
        local ok, a, b = pcall(function() return rem:InvokeServer(...) end)
        return ok, a, b
    end
    return false, "no remote " .. name
end
local function unreliable(name, ...)
    if isfn(G.Network, "UnreliableFire") then return gcall(G.Network.UnreliableFire, name, ...) end
    return fire(name, ...)
end
local function getSave()
    if not isfn(G.Save, "Get") then return nil end
    local ok, s = gcall(G.Save.Get)
    if ok and type(s) == "table" then return s end
end

