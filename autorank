    if not shouldHatch() or inInstance() then return end
    if os.clock() < hatchBackoff then return end
    local egg = bestEgg()
    if not (egg and egg.id) then return end
    if not breakState.on then setInstantBreak(true) end
    local amt = hatchAmount()
    local ok, res = invoke("Eggs_RequestPurchase", egg.id, amt)
