local function spawnLoop(name, fn, ivFn)
    task.spawn(function()
        while state.alive do
            local ok, err = pcall(fn)
            if not ok then warnlog(name.." error: "..tostring(err)) end
            if not state.alive then break end
            local okI, iv = pcall(ivFn)
            task.wait(math.max(0.05, (okI and tonumber(iv)) or 1))
        end
    end)
end

