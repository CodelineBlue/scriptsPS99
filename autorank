local eggCache = { at = 0, egg = nil }
local function bestEgg()
    local now = os.clock()
    if eggCache.egg and now - eggCache.at < 10 then
        if not eggCache.egg.part or eggCache.egg.part.Parent then return eggCache.egg end
    end
    if not (isfn(G.EggCmds, "GetHighestEggNumberAvailable") and isfn(G.EggsUtil, "GetIdByNumber")) then
        return eggCache.egg
    end
    local n = gval(G.EggCmds.GetHighestEggNumberAvailable)
    if type(n) ~= "number" then return eggCache.egg end
    local id = gval(G.EggsUtil.GetIdByNumber, n)
    if type(id) == "table" then id = id._id end
    if type(id) ~= "string" then return eggCache.egg end
    local dir = type(G.Eggs) == "table" and G.Eggs[id] or nil
    local petIds = {}
    if dir and type(dir.pets) == "table" then
        for _, e in pairs(dir.pets) do
            if type(e) == "table" and type(e[1]) == "string" then petIds[e[1]] = true
            elseif type(e) == "string" then petIds[e] = true end
        end
    end
    local part = nil
    if isfn(G.EggsUtil, "GetEggPart") then
        local p = gval(G.EggsUtil.GetEggPart, n)
        if typeof(p) == "Instance" then
            if p:IsA("BasePart") then part = p
            elseif p:IsA("Model") then part = p.PrimaryPart or p:FindFirstChildWhichIsA("BasePart", true) end
        end
    end
    eggCache.egg = { number = n, id = id, dir = dir, petIds = petIds, part = part, name = (dir and dir.name) or id }
    eggCache.at = now
    return eggCache.egg
end

local hatchCapCache = { at = 0, v = 1 }
local function maxHatch()
    local now = os.clock()
    if now - hatchCapCache.at < 30 then return hatchCapCache.v end
    local n = nil
    if isfn(G.EggCmds, "GetMaxHatch") then n = gval(G.EggCmds.GetMaxHatch) end
    if type(n) ~= "number" or n < 1 then n = hatchCapCache.v end
    hatchCapCache = { v = math.max(1, math.floor(n)), at = now }
    return hatchCapCache.v
end
local function hatchAmount()
    local cap = math.min(tonumber(CONFIG.HatchCap) or 99, maxHatch())
    return math.max(1, math.floor(cap))
end

local function inventory(cat)
    local save = getSave()
    local inv = save and save.Inventory
    return type(inv) == "table" and type(inv[cat]) == "table" and inv[cat] or {}
end
local function stacks(cat, pred)
    local out = {}
    for uid, item in pairs(inventory(cat)) do
        if type(item) == "table" then
            local amt = tonumber(item._am) or 1
            if amt >= 1 and (pred == nil or pred(item, amt)) then
                out[#out+1] = { uid = uid, item = item, amount = amt }
            end
        end
    end
    table.sort(out, function(a, b) return a.amount > b.amount end)
    return out
end
local function pickByPriority(list, priority)
    for _, id in ipairs(priority or {}) do
        for _, s in ipairs(list) do if s.item.id == id then return s end end
    end
end

