-- 12. BOOTSTRAP
-- =========================================================================
local function bootstrap()
    repeat task.wait() until game:IsLoaded() or not state.alive
    if not state.alive then return false end
    local t0 = os.clock()
    while state.alive do
        local lib = RS:FindFirstChild("Library")
        local cl = lib and lib:FindFirstChild("Client")
        if cl then break end
        if os.clock() - t0 > 90 then
            warn("[Nexus] Library.Client not found after 90s"); return false
        end
        task.wait(0.5)
    end
    loadAll()
    if not (G.Save and G.Network) then
        warn("[Nexus] Save/Network modules missing"); return false
    end
    t0 = os.clock()
    while state.alive and getSave() == nil do
        if os.clock() - t0 > 90 then
            warn("[Nexus] Save.Get() stuck for 90s"); return false
        end
        task.wait(0.5)
    end
    return state.alive
end

local function startThreads()
    spawnLoop("controller", controllerTick, function() return 1.0 end)
    spawnLoop("farm", farmTick, function()
        if CONFIG.AutoFarm then return CONFIG.FarmTick end
        return 1
    end)
    spawnLoop("hatch", hatchTick, function()
        if os.clock() < hatchBackoff then return math.min(5, hatchBackoff - os.clock()) end
        if shouldHatch() then return CONFIG.HatchTick end
        return 1
    end)
    spawnLoop("craft", craftTick, function() return CONFIG.CraftTick end)
    spawnLoop("events", eventTick, function() return CONFIG.EventTick end)
    spawnLoop("tap", tapTick, function()
        if CONFIG.AutoTap then return 1 / math.clamp(CONFIG.TapRate, 1, 20) end
        return 1
    end)
    spawnLoop("orbs", orbTick, function() return 0.2 end)
    spawnLoop("misc", miscTick, function() return 2.0 end)
    installBreakableListener()
end

task.spawn(function()
    log("v2.1 starting")
    if not bootstrap() then Stop(); return end
    log("Modules loaded")
    installAntiAFK()
