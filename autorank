-- live status
task.spawn(function()
    while task.wait(1) do
        if not getgenv().Nexus_IsRunning then break end
        pcall(function()
            local z = 0
            local ok, v = pcall(function() return bestUnlockedZone() end)
            if ok and v then z = v end
            if z < 0 then z = 0 end

            local parts = {}
            if val2.Rank then
                if z >= 41 then parts[#parts+1] = "Rank: ACTIVE"
                else parts[#parts+1] = "Rank: WAIT (zone " .. z .. "/41)" end
            else parts[#parts+1] = "Rank: OFF" end
            if val2.AutoFarmArea then parts[#parts+1] = "Farm: ON" end
            if val2.BuyZone then parts[#parts+1] = "Buy: ON" end
            if val2.AntiAFK then parts[#parts+1] = "AFK: ON" end
            status.Text = table.concat(parts, "  |  ")
        end)
    end
end)
