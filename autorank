local function handleGold(q)
    if not hasZoneAtLeast(31) then return end
    ensureEggBreak()
    local eggName = bestEggNameForCurrentZone()
    local set = eggName and eggPets(eggName) or {}
    local pool, total = {}, 0
    if library then
        pcall(function()
            for uid, pet in pairs(library.Get().Inventory.Pet) do
                if not pet.l and not pet.locked and not pet.lk and (tonumber(pet.pt) or 0) == 0 then
                    local id, m = tostring(pet.id), false
                    for k in pairs(set) do
                        if id == k or string.find(id, k) or string.find(k, id) then m = true; break end
                    end
                    if m then
                        local c = math.floor((tonumber(pet._am) or 1) / 10)
                        if c > 0 then table.insert(pool, { uid = uid, crafts = c }); total = total + c end
                    end
                end
            end
        end)
    end
    if total > 0 then
        local used, rem = {}, q.remaining
        table.sort(pool, function(a, b) return a.crafts > b.crafts end)
        for _, p in ipairs(pool) do
            if rem > 0 then
                local u = math.min(p.crafts, rem)
                table.insert(used, { uid = p.uid, amt = u }); rem = rem - u
            end
        end
        if #used > 0 then
            getgenv().IsDoingSpecificQuest = true
            gotoAndUseMachine(31, "GoldMachine")
            for _, u in ipairs(used) do
                machineAction("GoldMachine_Activate", "GoldMachine", u.uid, u.amt)
                task.wait(0.2)
            end
            getgenv().IsDoingSpecificQuest = false
        end
    end
    if total < q.remaining and eggName then
        if currentZoneByPosition() ~= bestUnlockedZone() then
            getgenv().IsMachineActionActive = true
            teleportToBestArea()
            task.wait(0.5)
            getgenv().IsMachineActionActive = false
