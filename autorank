-- live status
task.spawn(function()
    while task.wait(1) do
        if not getgenv().Nexus_IsRunning then break end
        pcall(function()
            local z = 0
            local ok, v = pcall(function() return bestUnlockedZone() end)
            if ok and v and v > 0 then z = v end
            local parts = {}
            if val2.Rank then
                if z >= 41 then parts[#parts+1] = "Rank: ACTIVE"
                else parts[#parts+1] = "Rank: WAIT (zone " .. z .. "/41)" end
            else parts[#parts+1] = "Rank: OFF" end
            if val2.AutoTap then parts[#parts+1] = "Tap: ON" end
            if val2.AutoCollectOrbs then parts[#parts+1] = "Orbs: ON" end
            if eggUIState.instantStored then parts[#parts+1] = "Auto-break: ON" end
            if val2.AutoFarmArea then parts[#parts+1] = "Farm: ON" end
            status.Text = table.concat(parts, "  |  ")
        end)
    end
end)
