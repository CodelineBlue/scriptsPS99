local function placeRange()
    local p = game.PlaceId
    if p == 8737899170 then return 1, 99
    elseif p == 16498369169 then return 100, 199
    elseif p == 17503543197 then return 200, 239
    elseif p == 140403681187145 or p == 17720827393 then return 240, 999 end
    return 1, 999
end

local function zoneNumberFromName(name, placeId)
    local n = tonumber(string.match(name, "^(%d+)"))
    if n then return n end
    local l = string.lower(name)
    if string.find(l, "shop") or string.find(l, "spawn") then
        if placeId == 16498369169 then return 100
        elseif placeId == 17503543197 then return 200
        elseif placeId == 140403681187145 or placeId == 17720827393 then return 240
        else return 1 end
    end
    return val8[name]
end

local cachedMaps
local function mapZones()
    if cachedMaps then return cachedMaps end
    local out = {}
    for _, n in ipairs({ "Map", "Map2", "Map3", "Map4" }) do
        local m = workspace:FindFirstChild(n)
        if m then
            for _, z in ipairs(m:GetChildren()) do
                if not string.find(string.lower(z.Name), "vip") then table.insert(out, z) end
            end
        end
    end
    cachedMaps = out
    return out
end

local function findZoneInstance(num)
    local fb
    for _, z in ipairs(mapZones()) do
        if zoneNumberFromName(z.Name, game.PlaceId) == num then
            if string.match(z.Name, "^(%d+)") then return z end
            fb = z
        end
    end
    return fb
end

local function zoneNameForTeleport(num)
    local p = game.PlaceId
    if p == 8737899170 and num == 1 then return "Spawn"
    elseif p == 16498369169 and num == 100 then return "Tech Spawn"
    elseif p == 17503543197 and num == 200 then return "Void Spawn"
    elseif (p == 140403681187145 or p == 17720827393) and num == 240 then return "Fantasy Spawn" end
    return val9[num]
end

local function bestUnlockedZone()
    local best = -1
    local mn, mx = placeRange()
    local tm = localPlayer.PlayerGui:FindFirstChild("TeleportMap")
    if tm then
        for _, n in ipairs(tm:GetDescendants()) do
            if n.Name == "textHolder" then
                local t, u = n:FindFirstChild("Title"), n:FindFirstChild("Number")
                if t and u and t:IsA("TextLabel") and u:IsA("TextLabel")
                    and t.Text ~= "???" and t.Text ~= "Locked" then
                    local d = string.match(u.Text, "%d+")
                    if d then
                        local v = tonumber(d)
                        if v and v >= mn and v <= mx and v > best then best = v end
                    end
                end
            end
        end
    end
    if best == -1 and library then
        pcall(function()
            local data = library.Get()
            if data and data.UnlockedZones then
                for k in pairs(data.UnlockedZones) do
                    local v = zoneNumberFromName(k, game.PlaceId)
                    if v and v >= mn and v <= mx and v > best then best = v end
                end
            end
        end)
    end
    return best, findZoneInstance(best)
end

local function hasZoneAtLeast(n) return (bestUnlockedZone()) >= n end

