local function installWebhookListener()
    if not isfn(G.Network, "Fired") then
        logOnce("wh-nofired", "Network.Fired unavailable — webhook hatch notifications disabled")
        return
    end
    pcall(function()
        local sig = G.Network.Fired("Eggs_PlayOpenAnimation")
