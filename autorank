        state.counters.hatched = state.counters.hatched + amt
        logEvery("hatch-ok", 30, "Hatched %s x%d", egg.name or egg.id, amt)
    else
        hatchFails = hatchFails + 1
        local d = ({ 1, 2, 5 })[math.min(hatchFails, 3)]
        hatchBackoff = os.clock() + d
        warnlog("hatch-fail", "hatch failed (%s)", tostring(res))
    end
end

