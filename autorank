-- =============== 2. Logging (writes to file on Delta) ===============
local LOG_FILE = "nexus_log.txt"
local function log(fmt, ...)
    local ok, s = pcall(string.format, tostring(fmt), ...)
    local msg = ok and s or tostring(fmt)
    pcall(print, "[Nexus] " .. msg)
    pcall(function()
        if not writefile then return end
        local old = ""
        if isfile and isfile(LOG_FILE) then
            local rok, data = pcall(readfile, LOG_FILE)
            if rok and type(data) == "string" then old = data end
        end
        if #old > 30000 then old = old:sub(-15000) end
        writefile(LOG_FILE, old .. os.date("[%H:%M:%S] ") .. msg .. "\n")
    end)
end
local function warnlog(fmt, ...)
    local ok, s = pcall(string.format, tostring(fmt), ...)
    local msg = ok and s or tostring(fmt)
    pcall(warn, "[Nexus] " .. msg)
    pcall(function()
        if not writefile then return end
        local old = ""
        if isfile and isfile(LOG_FILE) then
            local rok, data = pcall(readfile, LOG_FILE)
            if rok and type(data) == "string" then old = data end
        end
        writefile(LOG_FILE, old .. os.date("[%H:%M:%S] WARN ") .. msg .. "\n")
    end)
end

