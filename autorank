local function req(path)
    local node = RS
    for _, name in ipairs(path) do
        if not node then return nil end
        local child = node:FindFirstChild(name)
        if not child then
            local ok, r = pcall(function() return node:WaitForChild(name, 3) end)
            child = ok and r or nil
        end
        node = child
    end
    if not node then return nil end
    local ok, mod = pcall(require, node)
    if not ok then log("require " .. table.concat(path, ".") .. " FAILED: " .. tostring(mod)); return nil end
    return mod
end

