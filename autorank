local function rankInfo()
    local save = getSave()
    if not save then return nil end
    local info = {}
    info.rankNum = tonumber(save.Rank) or 1
    info.stars = tonumber(save.RankStars) or 0
    info.rankId = (G.RanksUtil and type(G.RanksUtil.RankIDFromNumber) == "function")
        and select(2, pcall(G.RanksUtil.RankIDFromNumber, info.rankNum)) or nil
    info.rankDir = (info.rankId and type(G.Ranks) == "table") and G.Ranks[info.rankId] or nil
    info.title = (info.rankDir and info.rankDir.Title) or ("Rank "..tostring(info.rankNum))
    info.rewards = (info.rankDir and type(info.rankDir.Rewards) == "table") and info.rankDir.Rewards or {}
    info.redeemed = type(save.RedeemedRankRewards) == "table" and save.RedeemedRankRewards or {}
    local cnt = 0
    for _, v in pairs(info.redeemed) do if v then cnt = cnt + 1 end end
    info.redeemedCount = cnt
    return info
end

local function readGoals()
    local save = getSave()
    local list, byType = {}, {}
    if not save or type(save.Goals) ~= "table" then return list, byType end
    for tier, g in pairs(save.Goals) do
        if type(g) == "table" and g.Type ~= nil then
            local copy = {
                tier=tier, Type=g.Type, UID=g.UID,
                Stars=tonumber(g.Stars) or 0,
                Amount=tonumber(g.Amount) or 0,
                Progress=tonumber(g.Progress) or 0,
                PotionTier=g.PotionTier, EnchantTier=g.EnchantTier,
                remaining=math.max(0, (tonumber(g.Amount) or 0) - (tonumber(g.Progress) or 0)),
                raw=g,
            }
            list[#list+1] = copy
            byType[copy.Type] = byType[copy.Type] or {}
            table.insert(byType[copy.Type], copy)
        end
    end
    return list, byType
end

local function curRemaining(goal)
    local save = getSave()
    if not (save and type(save.Goals) == "table") then return goal.remaining end
    for _, g in pairs(save.Goals) do
        if type(g) == "table" and g.UID == goal.UID then
            return math.max(0, (tonumber(g.Amount) or 0) - (tonumber(g.Progress) or 0))
        end
    end
    return 0
end

