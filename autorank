-- =============== HTTP timeout patch (Delta/MuMu fix) ===============
do
    local HTTP_TIMEOUT = 5
    local function wrap(name)
        local parts = {}
        for p in name:gmatch("[^%.]+") do parts[#parts+1] = p end
        local scope, key = _G, parts[1]
        for i = 2, #parts do scope = scope[parts[i-1]]; key = parts[i] end
        if type(scope) ~= "table" or type(scope[key]) ~= "function" then return end
        local orig = scope[key]
        scope[key] = function(opts)
            local result, finished = nil, false
            task.spawn(function()
                local ok, res = pcall(orig, opts)
                if ok and type(res) == "table" then result = res end
                finished = true
            end)
            local t0 = tick()
            while not finished and tick() - t0 < HTTP_TIMEOUT do task.wait(0.1) end
            if not finished then return { StatusCode = 0, Body = "", Headers = {} } end
            return result
        end
    end
    pcall(wrap, "request")
    pcall(wrap, "http_request")
    pcall(wrap, "syn.request")
    pcall(wrap, "http.request")
    pcall(wrap, "fluxus.request")
end

