local function maxHatchCount()
    if G_Eggs then
        local ok, v = pcall(G_Eggs.GetMaxHatch)
        if ok and tonumber(v) then return math.max(1, math.floor(v)) end
    end
    if library then
        local ok, d = pcall(function() return library.Get() end)
        if ok and d then
            local n = tonumber(d.EggHatchCount) or tonumber(d.MaxEggHatch) or tonumber(d.EggSlotsPurchased)
            if n then return math.max(1, math.floor(n)) end
        end
    end
    return 1
end

local function hatchQty()
    local cap = tonumber(getgenv().HatchCap) or 99
    local gameMax = maxHatchCount()
    return math.max(1, math.min(cap, gameMax))
end

-- =====================================================================
-- HIDE EGG UI + AUTO-BREAK SETUP (ported from DZ Hub)
-- This is what actually makes hatched eggs BREAK. Without it the eggs
-- spawn and then sit there waiting for a tap that never comes.
-- =====================================================================
local eggUIState = {
    animEnv = nil, animOriginal = nil,
    potatoOriginal = nil,
    instantStored = false, instantOriginal = nil,
}

local function clearStuckPrompt()
    for _, raiz in ipairs({ game:GetService("CoreGui"), localPlayer:FindFirstChild("PlayerGui") }) do
        if raiz then
            for _, g in ipairs(raiz:GetDescendants()) do
                if g.Name == "TapToOpen" then pcall(function() g:Destroy() end) end
            end
        end
    end
end

local function killPlayEggAnimation(on)
    if type(getsenv) ~= "function" then return end
    pcall(function()
        if on then
            if eggUIState.animOriginal then return end
            local ps = localPlayer:FindFirstChild("PlayerScripts")
            local sc = ps and ps:FindFirstChild("Scripts")
            local gameEnv = sc and sc:FindFirstChild("Game")
            local frontend = gameEnv and gameEnv:FindFirstChild("Egg Opening Frontend")
            if not frontend then return end
            local env = getsenv(frontend)
            if type(env) ~= "table" or type(env.PlayEggAnimation) ~= "function" then return end
            eggUIState.animEnv = env
            eggUIState.animOriginal = env.PlayEggAnimation
            env.PlayEggAnimation = function() end
        elseif eggUIState.animOriginal and eggUIState.animEnv then
            eggUIState.animEnv.PlayEggAnimation = eggUIState.animOriginal
            eggUIState.animOriginal = nil
            eggUIState.animEnv = nil
        end
    end)
end

local function setEggUIHidden(on)
    killPlayEggAnimation(on)

    if G_Settings then
        if on and not eggUIState.potatoOriginal then
            eggUIState.potatoOriginal = G_Settings.Get
            G_Settings.Get = function(label, ...)
                if label == "EggPotatoMode" then return "On" end
                return eggUIState.potatoOriginal(label, ...)
            end
        elseif not on and eggUIState.potatoOriginal then
            G_Settings.Get = eggUIState.potatoOriginal
            eggUIState.potatoOriginal = nil
        end
    end

    pcall(function()
        if on then
            if not eggUIState.instantStored then
                eggUIState.instantOriginal = workspace:GetAttribute("GlobalInstantHatch")
                eggUIState.instantStored = true
            end
            workspace:SetAttribute("GlobalInstantHatch", true)
        elseif eggUIState.instantStored then
            workspace:SetAttribute("GlobalInstantHatch", eggUIState.instantOriginal)
            eggUIState.instantStored = false
        end
    end)

    if on then clearStuckPrompt() end
end

-- Auto-break is forced on whenever hatch happens, regardless of the HideEggUI toggle
local function ensureEggBreak()
    if not eggUIState.instantStored then
        pcall(function() setEggUIHidden(true) end)
    end
end

task.spawn(function()
    while task.wait(1) do
        if not getgenv().Nexus_IsRunning then break end
        if val2.HideEggUI or eggUIState.instantStored then clearStuckPrompt() end
    end
end)

