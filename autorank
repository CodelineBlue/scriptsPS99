local eggCache = { at = 0, egg = nil }
local function bestEgg()
    local now = os.clock()
    if eggCache.egg and now - eggCache.at < 10 then
        if not eggCache.egg.part or eggCache.egg.part.Parent then return eggCache.egg end
    end
    if not (G.EggCmds and G.EggsUtil) then return eggCache.egg end
    if type(G.EggCmds.GetHighestEggNumberAvailable) ~= "function" then return eggCache.egg end
    local ok, n = pcall(G.EggCmds.GetHighestEggNumberAvailable)
    if not ok or type(n) ~= "number" then return eggCache.egg end
    if type(G.EggsUtil.GetIdByNumber) ~= "function" then return eggCache.egg end
    local ok2, id = pcall(G.EggsUtil.GetIdByNumber, n)
    if not ok2 then return eggCache.egg end
    if type(id) == "table" then id = id._id end
    if type(id) ~= "string" then return eggCache.egg end
    local dir = type(G.Eggs) == "table" and G.Eggs[id]
    local petIds = {}
    if dir and type(dir.pets) == "table" then
        for _, e in pairs(dir.pets) do
            if type(e) == "table" and type(e[1]) == "string" then petIds[e[1]] = true
            elseif type(e) == "string" then petIds[e] = true end
        end
    end
    local part
    if type(G.EggsUtil.GetEggPart) == "function" then
        local ok3, p = pcall(G.EggsUtil.GetEggPart, n)
        if ok3 and typeof(p) == "Instance" then
            if p:IsA("BasePart") then part = p
            elseif p:IsA("Model") then part = p.PrimaryPart or p:FindFirstChildWhichIsA("BasePart", true) end
        end
    end
    eggCache.egg = { number=n, id=id, dir=dir, petIds=petIds, part=part, name=(dir and dir.name) or id }
    eggCache.at = now
    return eggCache.egg
end

