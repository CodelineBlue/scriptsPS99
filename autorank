local function handleRainbow(q)
    if not hasZoneAtLeast(41) then return end
    ensureEggBreak()
    local eggName = bestEggNameForCurrentZone()
    local set = eggName and eggPets(eggName) or {}
    local base, rain, baseT, rainT = {}, {}, 0, 0
    if library then
        pcall(function()
            for uid, pet in pairs(library.Get().Inventory.Pet) do
                if not pet.l and not pet.locked and not pet.lk then
                    local pt = tonumber(pet.pt) or 0
                    if pt == 0 or pt == 1 then
                        local id, m = tostring(pet.id), false
                        for k in pairs(set) do
                            if id == k or string.find(id, k) or string.find(k, id) then m = true; break end
                        end
                        if m then
