local speedHookInstalled = false
local function installSpeedHook()
    if speedHookInstalled then return true end
    if not isfn(G.PlayerPet, "CalculateSpeedMultiplier") then
        logOnce("nospeedfn", "PlayerPet.CalculateSpeedMultiplier missing — Infinite Pet Speed unavailable")
        return false
    end
    local SPEED = 500
    if type(hookfunction) == "function" then
        local orig
        local ok, err = pcall(function()
            orig = hookfunction(G.PlayerPet.CalculateSpeedMultiplier, function(self, ...)
                if CONFIG.InfinitePetSpeed and state.alive then return SPEED end
                if type(orig) == "function" then return orig(self, ...) end
                return 1
            end)
        end)
        if ok and type(orig) == "function" then
            speedHookInstalled = true
            log("Pet speed hook installed (hookfunction)")
            return true
        end
        warnlog("speedhook-hook", "hookfunction failed: %s — trying fallback", tostring(err))
    end
    local ok, err = pcall(function()
        local orig = G.PlayerPet.CalculateSpeedMultiplier
        G.PlayerPet.CalculateSpeedMultiplier = function(self, ...)
            if CONFIG.InfinitePetSpeed and state.alive then return SPEED end
            return orig(self, ...)
        end
        speedHookInstalled = true
    end)
    if ok then
        log("Pet speed hook installed (reassignment fallback)")
        return true
    end
    warnlog("speedhook-fail", "no speed hook method available: %s", tostring(err))
    return false
end

