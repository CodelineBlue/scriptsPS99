local claimAt = {}
local function claimRewards(info)
    if not (CONFIG.AutoClaim and info) then return end
    local cum, now = 0, os.clock()
    for i, rw in ipairs(info.rewards) do
        cum = cum + (tonumber(type(rw) == "table" and rw.StarsRequired) or 0)
        if cum <= info.stars and info.redeemed[tostring(i)] == nil then
            if not claimAt[i] or now - claimAt[i] > 5 then
                claimAt[i] = now
                fire("Ranks_ClaimReward", i)
                log("Claimed reward #"..i)
                state.counters.claimed = state.counters.claimed + 1
                task.wait(0.3)
            end
        end
    end
end

