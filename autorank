local function toggle(label, key, onChange)
    local b = Instance.new("TextButton", scroll)
    b.Size = UDim2.new(1, -10, 0, 28)
    b.BackgroundColor3 = CONFIG[key] and C.ok or C.off
    b.BorderSizePixel, b.AutoButtonColor = 0, false
    b.Text = (CONFIG[key] and "[ON]  " or "[OFF] ") .. label
    b.TextColor3, b.Font, b.TextSize = C.text, FONT_M, 11
    b.TextXAlignment, b.LayoutOrder = Enum.TextXAlignment.Left, nextOrder()
    corner(b, 5)
    local pad = Instance.new("UIPadding", b); pad.PaddingLeft = UDim.new(0, 10)
    b.MouseButton1Click:Connect(function()
        CONFIG[key] = not CONFIG[key]
        b.BackgroundColor3 = CONFIG[key] and C.ok or C.off
        b.Text = (CONFIG[key] and "[ON]  " or "[OFF] ") .. label
        if onChange then pcall(onChange, CONFIG[key]) end
    end)
    return b
end
