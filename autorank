local speedInstalled = false
local function installSpeedHook()
    if speedInstalled then return true end
    if not (G.PlayerPet and type(G.PlayerPet.CalculateSpeedMultiplier) == "function") then
        log("pet speed fn missing")
        return false
    end
    local SPEED = 500
    if type(hookfunction) == "function" then
        local orig
        local ok = pcall(function()
            orig = hookfunction(G.PlayerPet.CalculateSpeedMultiplier, function(self, ...)
                if CONFIG.InfinitePetSpeed and state.alive then return SPEED end
                if type(orig) == "function" then return orig(self, ...) end
                return 1
            end)
        end)
        if ok and type(orig) == "function" then
            speedInstalled = true
            log("pet speed hook installed (hookfunction)")
            return true
        end
    end
    local ok = pcall(function()
        local orig = G.PlayerPet.CalculateSpeedMultiplier
        G.PlayerPet.CalculateSpeedMultiplier = function(self, ...)
            if CONFIG.InfinitePetSpeed and state.alive then return SPEED end
            return orig(self, ...)
        end
        speedInstalled = true
    end)
    if ok then log("pet speed hook installed (reassign)") end
    return ok
end

