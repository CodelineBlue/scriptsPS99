local function collectPotionForCraft(tier)
    local pool = { "Coins", "Damage", "Diamonds", "Lucky Eggs", "Treasure Hunter" }
    if not library then return nil, nil end
    local ok, d = pcall(function() return library.Get() end)
    if not ok or not d or not d.Inventory or not d.Inventory.Potion then return nil, nil end
    for _, name in ipairs(pool) do
        local uid, pt = nil, 999
        for k, item in pairs(d.Inventory.Potion) do
            if tostring(item.id) == name then
                local t = tonumber(item.tn) or 1
                local amt = tonumber(item._am) or 1
                if tier then
                    if t == tonumber(tier) and amt >= 1 then return k, name end
                elseif t < pt and amt >= 1 then
                    pt, uid = t, k
                end
            end
        end
        if not tier and uid then return uid, name end
    end
    return nil, nil
end

local function findUpgradeBundle(kind, amount, minTier)
    local pool = kind == "Potion"
        and { "Coins", "Damage", "Diamonds", "Lucky Eggs", "Treasure Hunter", "Speed" }
        or  { "Treasure Hunter", "Tap Power", "Strong Pets", "Speed", "Magnet",
              "Lucky Eggs", "Diamonds", "Criticals", "Coins" }
    local res, rem = {}, amount
    if not library then return res end
    local ok, d = pcall(function() return library.Get() end)
    if not ok or not d or not d.Inventory or not d.Inventory[kind] then return res end
    if minTier then
        local target = minTier - 1
        for _, name in ipairs(pool) do
            for uid, item in pairs(d.Inventory[kind]) do
                if tostring(item.id) == name and (tonumber(item.tn) or 1) == target then
                    local c = math.floor((tonumber(item._am) or 1) / 5)
                    if c > 0 then
                        local u = math.min(c, rem)
                        table.insert(res, { uid = uid, name = name, crafts = u })
                        rem = rem - u
                        if rem <= 0 then return res end
                    end
                end
            end
        end
    else
        for t = 1, 7 do
            for _, name in ipairs(pool) do
                for uid, item in pairs(d.Inventory[kind]) do
                    if tostring(item.id) == name and (tonumber(item.tn) or 1) == t then
                        local skip = false
                        if kind == "Potion" and name == "Speed" and t >= 3 then skip = true end
                        if kind == "Enchant" and name == "Magnet" and t >= 3 then skip = true end
                        if kind == "Enchant" and name == "Speed" and t >= 5 then skip = true end
                        if t >= 8 then skip = true end
                        if not skip then
                            local c = math.floor((tonumber(item._am) or 1) / 5)
                            if c > 0 then
                                local u = math.min(c, rem)
                                table.insert(res, { uid = uid, name = name, crafts = u })
                                rem = rem - u
                                if rem <= 0 then return res end
                            end
                        end
                    end
                end
            end
        end
    end
    return res
end

