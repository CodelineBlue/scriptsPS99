local function toggle(label, tbl, key, onChange)
    local b = Instance.new("TextButton", scroll)
    b.Size = UDim2.new(1, -10, 0, 28)
    b.BackgroundColor3 = tbl[key] and C.ok or C.off
    b.BorderSizePixel = 0; b.AutoButtonColor = false
    b.Text = (tbl[key] and "[ON]  " or "[OFF] ") .. label
    b.TextColor3 = C.text; b.Font = FONT_M; b.TextSize = 11
    b.TextXAlignment = Enum.TextXAlignment.Left; b.LayoutOrder = nextOrder()
    corner(b, 5)
    local pad = Instance.new("UIPadding", b); pad.PaddingLeft = UDim.new(0, 10)
    b.MouseButton1Click:Connect(function()
        tbl[key] = not tbl[key]
        b.BackgroundColor3 = tbl[key] and C.ok or C.off
        b.Text = (tbl[key] and "[ON]  " or "[OFF] ") .. label
        if onChange then pcall(onChange, tbl[key]) end
    end)
    return b
end

local function slider(label, get, set, min, max, step)
    local f = Instance.new("Frame", scroll)
    f.Size = UDim2.new(1, -10, 0, 30); f.BackgroundColor3 = C.panel
    f.BorderSizePixel = 0; f.LayoutOrder = nextOrder(); corner(f, 5)
    local l = Instance.new("TextLabel", f)
    l.Size = UDim2.new(0.55, 0, 1, 0); l.Position = UDim2.new(0, 10, 0, 0)
    l.BackgroundTransparency = 1; l.Text = label .. ": " .. tostring(get())
    l.TextColor3 = C.text; l.Font = FONT_M; l.TextSize = 11
    l.TextXAlignment = Enum.TextXAlignment.Left
    local box = Instance.new("TextBox", f)
    box.Size = UDim2.new(0.30, 0, 0.7, 0); box.Position = UDim2.new(0.65, 0, 0.15, 0)
    box.BackgroundColor3 = C.bg; box.BorderSizePixel = 0
    box.Text = tostring(get()); box.TextColor3 = C.accent; box.Font = FONT; box.TextSize = 11
    box.ClearTextOnFocus = false; corner(box, 4); stroke(box, C.line, 1)
    box.FocusLost:Connect(function()
        local n = tonumber(box.Text)
        if n then
            n = math.clamp(n, min, max)
            if step then n = math.floor(n / step + 0.5) * step end
            set(n)
        end
        box.Text = tostring(get())
        l.Text = label .. ": " .. tostring(get())
    end)
end

