getgenv().EggNameToNumber, getgenv().EggNumberToName = {}, {}

local function buildEggList()
    local out = {}
    local p = game.PlaceId
    local eggs = replicatedStorage:FindFirstChild("__DIRECTORY")
        and replicatedStorage.__DIRECTORY:FindFirstChild("Eggs")
    if not eggs then return out end
    for _, m in ipairs(eggs:GetDescendants()) do
        if m:IsA("ModuleScript") then
            local ok, d = pcall(require, m)
            if ok and type(d) == "table" and d.eggNumber then
                local n, allowed = d.eggNumber, true
                if p == 8737899170 and n > 112 then allowed = false
                elseif p == 16498369169 and (n <= 112 or n >= 213) then allowed = false
                elseif p == 17503543197 and (n < 213 or n >= 240) then allowed = false
                elseif (p == 140403681187145 or p == 17720827393) and n < 240 then allowed = false end
                if allowed then
                    local name = string.match(m.Name, "|%s*(.+)") or m.Name
                    getgenv().EggNameToNumber[name] = n
                    getgenv().EggNumberToName[n]    = name
                    table.insert(out, { name = name, num = n, zoneNum = d.zoneNumber or n })
                end
            end
        end
    end
    table.sort(out, function(a, b) return a.num < b.num end)
    return out
end
local val31 = buildEggList()

local function eggPets(eggName)
    local set = {}
    local eggs = replicatedStorage:FindFirstChild("__DIRECTORY")
        and replicatedStorage.__DIRECTORY:FindFirstChild("Eggs")
    if not eggs or not eggName then return set end
    for _, m in ipairs(eggs:GetDescendants()) do
        if (string.match(m.Name, "|%s*(.+)") or m.Name) == eggName then
            local ok, d = pcall(require, m)
            if ok and type(d) == "table" then
                local pets = d.pets or d.Pets or d.drops or d.Drops or d.items or d.Items or d.rewards
                if pets and type(pets) == "table" then
                    for _, p in pairs(pets) do
                        if type(p) == "table" and (p[1] or p.id or p.name) then
                            set[tostring(p[1] or p.id or p.name)] = true
                        elseif type(p) == "string" then set[p] = true end
                    end
                end
            end
            break
        end
    end
    return set
end

local function findItemUid(id, skipShiny)
    if not library then return nil end
    local ok, data = pcall(library.Get)
    if not ok or not data or not data.Inventory then return nil end
    for _, b in ipairs({ "Misc", "Lootbox", "Consumable", "Fruit" }) do
        if data.Inventory[b] then
            for uid, item in pairs(data.Inventory[b]) do
                if tostring(item.id) == id and not (skipShiny and item.sh) then return uid end
            end
        end
    end
    return nil
end

