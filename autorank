local function spawnLoop(name, tickFn, intervalFn)
    task.spawn(function()
        while state.alive and genv.Nexus_IsRunning do
            local ok, err = pcall(tickFn)
            if not ok then
                warnlog("loop-"..name, "%s: %s", name, tostring(err))
                task.wait(1)
            end
            if not state.alive or not genv.Nexus_IsRunning then break end
            local okI, iv = pcall(intervalFn)
            iv = okI and tonumber(iv) or 1
            task.wait(math.max(0.05, iv))
        end
    end)
end

local function controllerTick()
