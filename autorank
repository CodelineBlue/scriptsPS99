local function teleportToZone(zoneId)
    if isfn(G.ZonesUtil, "GetTeleportPartLocation") then
        local cf = gval(G.ZonesUtil.GetTeleportPartLocation, zoneId)
        local hrp = getHRP()
        if hrp and typeof(cf) == "CFrame" then
            hrp.CFrame = cf + Vector3.new(0, 4, 0)
            hrp.AssemblyLinearVelocity = Vector3.zero
            task.wait(0.5)
            return true
        end
    end
end

local function ensureInBestZone()
    if state.worldSwitching or state.worldMismatch or inInstance() then return false end
    local zoneId = bestZoneId()
    if not zoneId then return false end
    local hrp = getHRP()
    if not hrp then return false end
    local pos
    if isfn(G.ZonesUtil, "GetInteractFolder") then
        local folder = gval(G.ZonesUtil.GetInteractFolder, zoneId)
        if typeof(folder) == "Instance" then
            local bz = folder:FindFirstChild("BREAK_ZONES")
            if bz then
                for _, d in ipairs(bz:GetDescendants()) do
                    if d:IsA("BasePart") then pos = d.Position + Vector3.new(0, 4, 0); break end
                end
            end
        end
    end
    if not pos and isfn(G.ZonesUtil, "GetTeleportPartLocation") then
        local cf = gval(G.ZonesUtil.GetTeleportPartLocation, zoneId)
        if typeof(cf) == "CFrame" then pos = cf.Position + Vector3.new(0, 3, 0) end
    end
    if not pos then return false end
    if (hrp.Position - pos).Magnitude > 25 then
        hrp.CFrame = CFrame.new(pos)
        hrp.AssemblyLinearVelocity = Vector3.zero
        return true
    end
    return false
end

local function handleGoldRainbow(goal)
    local isGold = GOLD_TYPES[goal.Type] ~= nil
    local rem = currentRemaining(goal)
    if rem <= 0 then return end
    local egg = bestEgg()
    if not (egg and egg.petIds and next(egg.petIds) ~= nil) then
        state.needHatch = true; state.needHatchReason = "gold/rainbow — no egg pets known"
        return
    end
    local ptWanted = isGold and 0 or 1
    local remote = isGold and "GoldMachine_Activate" or "RainbowMachine_Activate"
    local fodder = stacks("Pet", function(item)
        local pt = tonumber(item.pt) or 0
        if pt ~= ptWanted then return false end
        if item.sh == true then return false end
        if not egg.petIds[item.id] then return false end
        return true
    end)
    for _, s in ipairs(fodder) do
        if rem <= 0 or not state.alive then break end
        while s.amount >= 10 and rem > 0 and state.alive do
            local k = math.min(math.floor(s.amount / 10), rem, 50)
            local ok, res = invoke(remote, s.uid, k)
            if ok and res == true then
                state.counters.crafted = state.counters.crafted + k
                rem = rem - k
                s.amount = s.amount - k * 10
                rem = math.min(rem, currentRemaining(goal))
                task.wait(0.5)
            else break end
        end
    end
    -- gold goal ran dry -> queue more hatching for fodder
    if currentRemaining(goal) > 0 then
        state.needHatch = true
        state.needHatchReason = isGold and "gold fodder (normal pets)" or "rainbow fodder (golden pets)"
    end
end

local function handleUsePotions(goal)
    local T = tonumber(goal.PotionTier or (goal.raw and goal.raw.PotionTier))
    if not T then return end
    local rem = currentRemaining(goal)
    if rem <= 0 then return end
    local list = stacks("Potion", function(item) return tonumber(item.tn) == T end)
    local priority = { "Lucky","Coins","Diamonds","Treasure Hunter","Damage" }
    local used = 0
    for _ = 1, math.min(rem, 10) do
        local s = pickByPriority(list, priority) or list[1]
        if not s then break end
        if not fire("Potions: Consume", s.uid, 1) then break end
        used = used + 1
        state.counters.itemsUsed = state.counters.itemsUsed + 1
        task.wait(0.4)
    end
    if used > 0 then log("Used %d tier %d potion(s)", used, T) end
end

local function handleUpgrade(goal, kind)
    local T = tonumber(kind == "potion" and goal.PotionTier or goal.EnchantTier)
    if not T or T < 2 then return end
    local rem = currentRemaining(goal)
    if rem <= 0 then return end
    local cat = kind == "potion" and "Potion" or "Enchant"
    local remote = kind == "potion" and "UpgradePotionsMachine_Activate" or "UpgradeEnchantsMachine_Activate"
    local need = 3
    local calcFn = kind == "potion" and G.CalcPotionsPerTierRequired or G.CalcEnchantsPerTierRequired
    if type(calcFn) == "function" then
        local n = gval(calcFn, T - 1)
        if type(n) == "number" and n >= 1 then need = math.floor(n) end
    end
    local list = stacks(cat, function(item) return tonumber(item.tn) == T - 1 end)
    for _, s in ipairs(list) do
        if rem <= 0 or not state.alive then break end
        if s.amount >= need then
            local k = math.min(math.floor(s.amount / need), rem, 25)
            local ok, res = invoke(remote, s.uid, k)
            if ok and res == true then
                state.counters.crafted = state.counters.crafted + k
                rem = rem - k
                rem = math.min(rem, currentRemaining(goal))
                task.wait(0.5)
            else break end
        end
    end
end

local function handleUseFruits(goal)
    local rem = currentRemaining(goal)
    if rem <= 0 then return end
    local priority = { "Apple","Orange","Pineapple","Banana","Watermelon","Rainbow" }
    local list = stacks("Fruit", function(item) return item.sh ~= true end)
    local used = 0
    for _ = 1, math.min(rem, 10) do
        local s = pickByPriority(list, priority) or list[1]
        if not s then break end
        if not fire("Fruits: Consume", s.uid, 1) then break end
        used = used + 1
        state.counters.itemsUsed = state.counters.itemsUsed + 1
        task.wait(0.4)
    end
    if used > 0 then log("Used %d fruit(s)", used) end
end

local function handleUseFlags(goal)
    local rem = currentRemaining(goal)
    if rem <= 0 then return end
    ensureInBestZone()
    local priority = { "Coins Flag","Diamonds Flag","Hasty Flag","Strength Flag","Magnet Flag","Fortune Flag","Shiny Flag" }
    local list = stacks("Misc", function(item) return type(item.id) == "string" and item.id:sub(-5) == " Flag" end)
    local s = pickByPriority(list, priority) or list[1]
    if not s then return end
    if isfn(G.FlexibleFlagCmds, "Consume") then
        local ok, res = gcall(G.FlexibleFlagCmds.Consume, s.item.id, s.uid, 1)
        if ok and res == true then state.counters.itemsUsed = state.counters.itemsUsed + 1 end
    else
        if invoke("FlexibleFlags_Consume", s.item.id, s.uid) then
            state.counters.itemsUsed = state.counters.itemsUsed + 1
        end
    end
end

local function handleEventSpawn(goal)
    local kind = EVENT_TYPES[goal.Type]
    if not kind then return end
    local def = EVENT_DEFS[kind]
    if not def then return end
    local rem = currentRemaining(goal)
    if rem <= 0 then return end
    ensureInBestZone()
    local now = os.clock()
    if now - (state.lastEventSpawn[kind] or -1e9) < 12 then return end
    local list = stacks("Misc", function(item)
        for _, id in ipairs(def.items) do if item.id == id then return true end end
        return false
    end)
    local s = list[1]
    if not s then return end
    local ok, res = invoke(def.remote, s.uid)
    if ok and res == true then
        state.lastEventSpawn[kind] = now
        state.counters.itemsUsed = state.counters.itemsUsed + 1
        log("Spawned %s", tostring(s.item.id))
        task.wait(0.3)
    end
end

local function handleLegendary()
    local egg = bestEgg()
    if not egg or not egg.id then return end
    local hrp = getHRP()
    if hrp and egg.part and egg.part.Parent and (hrp.Position - egg.part.Position).Magnitude > 85 then
        teleportToZone(bestZoneId())
    end
    invoke("Eggs_RequestPurchase", egg.id, hatchAmount())
end

local function dispatchGoal(goal)
    local t = goal.Type
    if FARM_TYPES[t] then return end
    if HATCH_TYPES[t] and CONFIG.AutoHatch then return end
    if GOLD_TYPES[t] or RAINBOW_TYPES[t] then
        if CONFIG.AutoCraftGoldRainbow then handleGoldRainbow(goal) end
        return
    end
    if t == 42 and CONFIG.AutoHatch then handleLegendary(); return end
    if t == 34 and CONFIG.AutoUsePotions then handleUsePotions(goal); return end
    if t == 12 and CONFIG.AutoUpgradePotions then handleUpgrade(goal, "potion"); return end
    if t == 13 and CONFIG.AutoUpgradeEnchants then handleUpgrade(goal, "enchant"); return end
    if t == 35 and CONFIG.AutoUseFruits then handleUseFruits(goal); return end
    if t == 33 and CONFIG.AutoUseFlags then handleUseFlags(goal); return end
    if EVENT_TYPES[t] and CONFIG.AutoSpawnEvents then handleEventSpawn(goal); return end
end

