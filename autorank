local WH = {
    url = "", enabled = false,
    categories = { Huge = true, Titanic = true, Gargantuan = true },
    queue = {}, imageCache = {},
}

local function httpPost(url, body)
    local req = (type(request) == "function" and request)
             or (type(http_request) == "function" and http_request)
             or (syn and type(syn.request) == "function" and syn.request)
    if not req then return false, "no HTTP function" end
    local ok, res = pcall(req, {
        Url = url, Method = "POST",
        Headers = { ["Content-Type"] = "application/json" },
        Body = body,
    })
    if not ok then return false, tostring(res) end
    local status = tonumber(res and (res.StatusCode or res.Status)) or 0
    return status >= 200 and status < 300, "HTTP "..tostring(status)
end

local function petDirTable()
    if type(G.Directory) ~= "table" then return nil end
    local ok, sub = gcall(function() return G.Directory.Pets end)
    if ok and type(sub) == "table" then return sub end
    return nil
end

local function petInfo(petId)
    local pets = petDirTable()
    if not pets then return nil end
    return pets[petId]
end

local function petCategory(petId)
    local pd = petInfo(petId)
    local name = tostring((pd and pd.name) or petId or "")
    for _, cat in ipairs({ "Gargantuan", "Titanic", "Huge" }) do
        if name:sub(1, #cat + 1) == cat .. " " then return cat end
    end
end

local function passesFilter(petId)
    local cat = petCategory(petId)
    if not cat then return false end
    if not next(WH.categories) then return true end
    return WH.categories[cat] == true
end

local function petImageUrl(petId)
    if WH.imageCache[petId] ~= nil then return WH.imageCache[petId] or nil end
    local pd = petInfo(petId)
    local asset = pd and tostring(pd.thumbnail or ""):match("(%d+)")
    if not asset then WH.imageCache[petId] = false; return nil end
    local req = (type(request) == "function" and request)
             or (type(http_request) == "function" and http_request)
             or (syn and type(syn.request) == "function" and syn.request)
    if not req then WH.imageCache[petId] = false; return nil end
    local url = ("https://thumbnails.roblox.com/v1/assets?assetIds=%s&size=420x420&format=Png&isCircular=false"):format(asset)
    local ok, res = pcall(req, { Url = url, Method = "GET" })
    local payload = ok and res and tostring(res.Body or "") or ""
    local img = payload:match('"imageUrl"%s*:%s*"([^"]+)"')
    if img then img = img:gsub("\\/", "/") end
    WH.imageCache[petId] = img or false
    return img
end

local CAT_COLORS = { Huge = 0x3BA3FF, Titanic = 0xB45CFF, Gargantuan = 0xFFB020 }

local function sendPetNotification(petId, eggName)
    if WH.url == "" then return end
    local cat = petCategory(petId)
    if not cat then return end
    local pd = petInfo(petId)
    local fields = {}
    if pd then
        local p = tonumber(pd.power) or tonumber(pd.cachedPower and pd.cachedPower[1])
        if p then fields[#fields+1] = { name = "Power", value = tostring(math.floor(p)), inline = true } end
    end
    if eggName then fields[#fields+1] = { name = "Egg", value = tostring(eggName), inline = true } end
    local embed = {
        author = { name = "Pet Simulator 99" },
        title = tostring(petId),
        description = "**" .. cat .. "**",
        color = CAT_COLORS[cat] or 5814783,
        fields = fields,
        footer = { text = "Nexus Hub · " .. os.date("%H:%M:%S") },
    }
    local img = petImageUrl(petId)
    if img then embed.thumbnail = { url = img } end
    local body = HttpService:JSONEncode({ username = "Nexus Hub", embeds = { embed } })
    local ok, msg = httpPost(WH.url, body)
    if not ok then
        warnlog("wh-fail", "webhook failed: %s", tostring(msg))
        WH.enabled = false
    end
end

