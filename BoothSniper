-- ============================================================
-- HTTP + API
-- ============================================================
local API_BASE = "https://ps99.biggamesapi.io/api"
local RAP_BASE = "https://ps99rap.com/api"

local function httpGet(url)
    local req = (syn and syn.request) or (http and http.request) or http_request or request
    if req then
        local ok, res = pcall(function() return req({ Url = url, Method = "GET" }) end)
        if ok and res and res.Body then return res.Body end
    end
    local ok, body = pcall(function() return game:HttpGet(url) end)
    return ok and body or nil
end

local function httpPost(url, payload)
    local req = (syn and syn.request) or (http and http.request) or http_request or request
    if req then
        pcall(function()
            req({
                Url = url, Method = "POST",
                Headers = { ["Content-Type"] = "application/json" },
                Body = httpService:JSONEncode(payload),
            })
        end)
    end
end

-- ============================================================
-- LOAD GAME DATA (collections)
-- ============================================================
local function loadGameData()
    if Sniper.GameDataLoaded or Sniper.GameDataLoading
        or tick() - Sniper.GameDataLastAttempt < Sniper.GameDataRetryInterval then
        return
    end
    Sniper.GameDataLoading = true
    Sniper.GameDataLastAttempt = tick()

    local collections = {
        { api = "Pets", target = "Pets" },
        { api = "Booths", target = "Booths" },
        { api = "Enchants", target = "Enchants" },
        { api = "MiscItems", target = "Misc" },
        { api = "Consumables", target = "Consumables" },
    }

    for _, c in ipairs(collections) do
        if not Sniper.GameDataCollectionsLoaded[c.target] then
            local body = httpGet(API_BASE .. "/collection/" .. c.api)
            if body then
                local ok, data = pcall(function() return httpService:JSONDecode(body) end)
                if ok and data and type(data.data) == "table" then
                    for _, entry in ipairs(data.data) do
                        if type(entry) == "table" then
                            local configData = type(entry.configData) == "table" and entry.configData or nil
                            local name = entry.configName or (configData and configData.name)
                            if type(name) == "string" then
                                Sniper.GameData[c.target][name] = entry
                            end
                        end
                    end
                    Sniper.GameDataCollectionsLoaded[c.target] = true
                end
            end
        end
    end

    Sniper.GameDataLoaded = true
    for _, c in ipairs(collections) do
        if not Sniper.GameDataCollectionsLoaded[c.target] then
            Sniper.GameDataLoaded = false
            break
        end
    end
    Sniper.GameDataLoading = false
end

-- ============================================================
-- RAP
-- ============================================================
local function fetchRap()
    if tick() - Sniper.RapLastFetch < Sniper.RapFetchInterval and next(Sniper.RapData) then
        return
    end
    local body = httpGet(RAP_BASE .. "/items")
    if not body then return end
    local ok, data = pcall(function() return httpService:JSONDecode(body) end)
    if ok and data then
        Sniper.RapData = data
        Sniper.RapLastFetch = tick()
    end
end

local function getRap(itemName, category)
    fetchRap()
    if Sniper.RapData[itemName] then
        return tonumber(Sniper.RapData[itemName].rap) or 0
    end
    local lower = string.lower(itemName)
    for id, entry in pairs(Sniper.RapData) do
        local n = entry.name or entry.id or tostring(id)
        if string.lower(n) == lower then
            return tonumber(entry.rap) or 0
        end
    end
    return 0
end

-- ============================================================
-- BOOTH SCANNING
-- ============================================================
local function parsePrice(str)
    if not str then return 0 end
    local num = str:match("([%d%.]+)")
    if not num then return 0 end
    local n = tonumber(num)
    if not n then return 0 end
    local suffix = str:match("[KMBTkmbt]")
    if suffix then
        suffix = string.upper(suffix)
        if suffix == "K" then return n * 1e3
        elseif suffix == "M" then return n * 1e6
        elseif suffix == "B" then return n * 1e9
        elseif suffix == "T" then return n * 1e12 end
    end
    return n
end

local function scanBooths()
    local items = {}
    local seen = {}
    local plaza = workspace:FindFirstChild("TradingPlaza")
        or workspace:FindFirstChild("Plaza")
        or workspace:FindFirstChild("Trading")
    if not plaza then return items end

    for _, obj in ipairs(plaza:GetDescendants()) do
        if obj:IsA("Model") and (obj.Name:lower():find("booth") or obj.Name:lower():find("shop")) then
            local owner = obj:GetAttribute("Owner") or obj:GetAttribute("Player") or "Unknown"
            for _, child in ipairs(obj:GetDescendants()) do
                if child:IsA("TextLabel") and child.Text ~= "" then
                    local text = child.Text
                    local name, price = text:match("(.+)%-%s*([%d%.]+[KMBTkmbt]?)")
                    if name and price then
                        local cleanName = name:gsub("^%s*(.-)%s*$", "%1")
                        local p = parsePrice(price)
                        if p > 0 then
                            local key = string.lower(string.format("%s|%s|%s", tostring(owner), cleanName, tostring(p)))
                            if not seen[key] then
                                seen[key] = true
                                table.insert(items, {
                                    owner = owner,
                                    itemName = cleanName,
                                    price = p,
                                    booth = obj,
                                })
                            end
                        end
                    end
                end
            end
        end
    end
    return items
end

-- ============================================================
-- REMOTE DETECTION (dynamic — finds the booth purchase remote)
-- ============================================================
local function findBoothRemote()
    local network = replicatedStorage:FindFirstChild("Network")
    if not network then return nil end

    -- known/likely remote names (updated with PS99 conventions)
    local candidates = {
        "Booths_RequestPurchase",
        "Booths_Purchase",
        "Booths_Buy",
        "TradingBooth_Purchase",
        "Booth_RequestPurchase",
        "Booths_RequestBuy",
        "TradeBooths_Purchase",
        "PlazaBooths_Purchase",
        "BoothsMachine_RequestPurchase",
    }

    for _, name in ipairs(candidates) do
        local remote = network:FindFirstChild(name)
        if remote and (remote:IsA("RemoteFunction") or remote:IsA("RemoteEvent")) then
            return remote
        end
    end

    -- dynamic fallback: scan for any remote with "booth" in the name
    for _, child in ipairs(network:GetChildren()) do
        if child.Name:lower():find("booth") and (child:IsA("RemoteFunction") or child:IsA("RemoteEvent")) then
            return child
        end
    end

    return nil
end

local function purchaseItem(item)
    local remote = findBoothRemote()
    if not remote then return nil end
    local ok, result = pcall(function()
        if remote:IsA("RemoteFunction") then
            return remote:InvokeServer(item.owner, item.itemName, item.price)
        elseif remote:IsA("RemoteEvent") then
            remote:FireServer(item.owner, item.itemName, item.price)
            return "sent"
        end
    end)
    if not ok or result == false then return nil end
    if result == true then return "confirmed" end
    return "sent"
end

-- ============================================================
-- MATCHING
-- ============================================================
local function matchesRule(itemName, itemPrice, rule, category)
    if rule.BlackList then
        for _, blocked in ipairs(rule.BlackList) do
            if itemName == blocked then return false end
        end
    end

    if rule.Tier ~= nil or rule.Shiny ~= nil then
        local collection = category
        if collection == "Pet" then collection = "Pets" end
        if collection == "Misc" then collection = "Misc" end
        if collection == "Consumable" then collection = "Consumables" end
        if collection == "Enchant" then collection = "Enchants" end
        local entry = Sniper.GameData[collection] and Sniper.GameData[collection][itemName]
        local configData = entry and type(entry.configData) == "table" and entry.configData or {}
        local tier = entry and (entry.tier or entry.Tier) or configData.tier or configData.Tier
        local shiny = entry and entry.shiny
        if shiny == nil then shiny = entry and entry.Shiny end
        if shiny == nil then shiny = configData.shiny end
        if shiny == nil then shiny = configData.Shiny end

        if rule.Tier ~= nil and tonumber(tier) ~= tonumber(rule.Tier) then return false end
        if rule.Shiny ~= nil and shiny ~= rule.Shiny then return false end
    end

    local rap = getRap(itemName, category)
    if rap <= 0 then return false end

    local pct = tonumber(rule.PercentageProfit) or 0
    local maxPrice = rap * (1 - pct / 100)

    if rule.MaxPrice and rule.MaxPrice > 0 then
        maxPrice = math.min(maxPrice, rule.MaxPrice)
    end

    return itemPrice <= maxPrice
end

local function shouldBuy(item)
    for _, rule in ipairs(Settings.Items) do
        if rule.Item == item.itemName then
            if matchesRule(item.itemName, item.price, rule, rule.Class) then
                return true
            end
        end
    end

    for cat, rule in pairs(Settings.Extras) do
        if rule.Enabled then
            local catName = cat:gsub("Pet$", "")
            local itemData = Sniper.GameData.Pets[item.itemName]
            local matches = false
            if cat == "AnyItem" then
                matches = true
            elseif itemData and itemData.category == catName then
                matches = true
            end
            if matches and matchesRule(item.itemName, item.price, rule, "Pets") then
                return true
            end
        end
    end

    for cat, rules in pairs(Settings.CustomExtras) do
        for _, rule in ipairs(rules) do
            if rule.Enabled and matchesRule(item.itemName, item.price, rule, cat) then
                return true
            end
        end
    end

    return false
end

-- ============================================================
-- NOTIFY
-- ============================================================
local function notify(item, confirmed)
    local status = confirmed and "Purchase confirmed" or "Purchase request sent (not confirmed)"
    local msg = string.format("**%s**\nItem: %s\nPrice: %s\nOwner: %s",
        status, item.itemName, tostring(item.price), tostring(item.owner))

    if Settings.Webhook.Enabled and Settings.Webhook.URL ~= "" then
        httpPost(Settings.Webhook.URL, { content = msg, username = "Booth Sniper" })
    end

    pcall(function()
        game:GetService("StarterGui"):SetCore("SendNotification", {
            Title = status,
            Text = item.itemName .. " for " .. tostring(item.price),
            Duration = 5,
        })
    end)

    table.insert(Sniper.Purchases, {
        name = item.itemName,
        price = item.price,
        time = os.time(),
        confirmed = confirmed,
    })
    if confirmed then
        Sniper.PurchaseCount = Sniper.PurchaseCount + 1
        Sniper.TotalSpent = Sniper.TotalSpent + item.price
    end
end

-- ============================================================
-- SERVER HOP
-- ============================================================
local function serverHop()
    if not Settings.ServerHop.Enabled then return end
    local body = httpGet(string.format(
        "https://games.roblox.com/v1/games/%d/servers/Public?limit=100", game.PlaceId))
    if not body then return end
    local ok, data = pcall(function() return httpService:JSONDecode(body) end)
    if not ok or not data or not data.data then return end
    for _, s in ipairs(data.data) do
        if s.id ~= game.JobId and s.playing < s.maxPlayers then
            pcall(function()
                game:GetService("TeleportService"):TeleportToPlaceInstance(game.PlaceId, s.id, localPlayer)
            end)
            return
        end
    end
end

-- ============================================================
-- MAIN LOOP
-- ============================================================
task.spawn(function()
    loadGameData()
    fetchRap()

    while true do
        task.wait(0.5)
        if not Sniper.Running then
            continue
        end
        if not Sniper.GameDataLoaded then
            loadGameData()
        end

        local gems = nil
        pcall(function()
            local lib = require(replicatedStorage.Library.Client.Save)
            local save = lib.Get()
            if save and save.Inventory and save.Inventory.Currency then
                gems = tonumber(save.Inventory.Currency.Diamonds)
            end
        end)

        if Settings.ServerHop.Enabled and tick() - Sniper.LastHop > Sniper.HopInterval then
            Sniper.LastHop = tick()
            serverHop()
        end

        if not gems or gems < Settings.MinimumGems then
            task.wait(2)
            continue
        end

        local items = scanBooths()
        if tick() - Sniper.LastRequestCleanup >= 30 then
            for key, requestedAt in pairs(Sniper.RecentRequests) do
                if tick() - requestedAt >= 15 then
                    Sniper.RecentRequests[key] = nil
                end
            end
            Sniper.LastRequestCleanup = tick()
        end
        for _, item in ipairs(items) do
            local requestKey = string.lower(string.format("%s|%s|%s",
                tostring(item.owner), item.itemName, tostring(item.price)))
            local lastRequest = Sniper.RecentRequests[requestKey]
            if lastRequest and tick() - lastRequest < 15 then
                continue
            end
            if Sniper.Running and gems >= item.price then
                if shouldBuy(item) then
                    local outcome = purchaseItem(item)
                    if outcome then
                        Sniper.RecentRequests[requestKey] = tick()
                        gems = gems - item.price
                        notify(item, outcome == "confirmed")
                    end
                end
            end
        end
    end
end)

