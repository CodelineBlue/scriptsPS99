local function runSearch()
    local query = string.lower(mItemInput.get())
    local class = mClass.get()
    local collectionByClass = {
        Pet = "Pets",
        Misc = "Misc",
        Consumable = "Consumables",
        Enchant = "Enchants",
        Booth = "Booths",
    }
    local target = Sniper.GameData[collectionByClass[class] or class] or {}
    if not Sniper.GameDataLoaded then
        task.spawn(loadGameData)
    end

    for _, c in ipairs(srList:GetChildren()) do
        if c:IsA("TextButton") or c:IsA("TextLabel") then c:Destroy() end
    end

    local count = 0
    for name, _ in pairs(target) do
        if string.find(string.lower(name), query, 1, true) then
            local btn = Instance.new("TextButton", srList)
            btn.Size = UDim2.new(1, -5, 0, 22); btn.BackgroundColor3 = COL_ROW
            btn.Text = name; btn.TextColor3 = COL_TEXT
            btn.Font = Enum.Font.GothamSemibold; btn.TextSize = 10
            btn.BorderSizePixel = 0; btn.ZIndex = 22; newCorner(btn, 3)
            btn.LayoutOrder = count
            btn.MouseButton1Click:Connect(function()
                mItemInput.set(name)
                searchResults.Visible = false
            end)
            count = count + 1
        end
        if count >= 50 then break end
    end

    srList.CanvasSize = UDim2.new(0, 0, 0, srLayout.AbsoluteContentSize.Y + 10)
    if count == 0 then
        local empty = Instance.new("TextLabel", srList)
        empty.Size = UDim2.new(1, -5, 0, 22)
        empty.BackgroundTransparency = 1
        if not collectionByClass[class] and not Sniper.GameData[class] then
            empty.Text = "No API collection is configured for this class"
        elseif Sniper.GameDataLoaded then
            empty.Text = "No matching items found"
        else
            empty.Text = "Item data is loading or unavailable; try again shortly"
        end
        empty.TextColor3 = COL_MUTED
        empty.Font = Enum.Font.GothamSemibold
        empty.TextSize = 10
        empty.ZIndex = 22
        srList.CanvasSize = UDim2.new(0, 0, 0, 32)
    end
    searchResults.Visible = true
end

searchBtn.MouseButton1Click:Connect(runSearch)

