-- history updater
task.spawn(function()
    while gui.Parent do
        task.wait(1)
        histStats.Text = string.format("Confirmed purchases: %d | Total Spent: %s",
            Sniper.PurchaseCount, tostring(Sniper.TotalSpent))

        for _, c in ipairs(histContainer:GetChildren()) do
            if c:IsA("Frame") then c:Destroy() end
        end

        local start = math.max(1, #Sniper.Purchases - 49)
        for i = start, #Sniper.Purchases do
            local p = Sniper.Purchases[i]
            local row = Instance.new("Frame", histContainer)
            row.Size = UDim2.new(1, 0, 0, 24); row.BackgroundColor3 = COL_ROW
            row.BorderSizePixel = 0; newCorner(row, 4)
            local t = Instance.new("TextLabel", row)
            t.Size = UDim2.new(1, -10, 1, 0); t.Position = UDim2.new(0, 8, 0, 0)
            t.BackgroundTransparency = 1
            local status = p.confirmed and "CONFIRMED" or "UNCONFIRMED"
            t.Text = string.format("%s — %s [%s] (%s)",
                p.name, tostring(p.price), status, os.date("%H:%M:%S", p.time))
            t.TextColor3 = COL_TEXT; t.Font = Enum.Font.GothamSemibold
            t.TextSize = 10; t.TextXAlignment = Enum.TextXAlignment.Left
        end
    end
end)

